# Alpaca paper account — sign up at https://app.alpaca.markets/
# Use PAPER keys only. Live keys are not needed for this project.
ALPACA_API_KEY=PK_REPLACE_ME
ALPACA_API_SECRET=REPLACE_ME
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Optional: only needed once you want to read your own Polymarket positions.
# Read at /api/snapshot only; never used to sign transactions.
POLYMARKET_WALLET=

# Optional: same as above for Hyperliquid.
HYPERLIQUID_WALLET=

# Trading 212 public API key (Invest / Stocks ISA only).
# Generate from the T212 app → Settings → API. Read-only scope is enough.
# The handover doc claimed there was no API; there is — this adapter uses it.
TRADING212_API_KEY=

# Logging
LOG_LEVEL=INFO

# Bind host. Keep localhost for security — there's no auth.
HOST=127.0.0.1
PORT=8000
